# GEMINI_API_KEY: Optional fallback if Gemini is used for auxiliary workflows
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# ==============================================================================
# SHERLOG - INCIDENT INVESTIGATION AGENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Meterless Nightshift AI Configuration (PRIMARY AI Provider)
# Every model call routes through Nightshift.
NIGHTSHIFT_API_KEY=""
NIGHTSHIFT_BASE_URL="https://api.meterless.ai/v1"
NIGHTSHIFT_ROUTER_MODEL="meterless/nightshift-router-v1"
NIGHTSHIFT_NEMOTRON_MODEL="nvidia/nemotron-4-340b-instruct"

# Meterless Engine Configuration
# Enabled Engine: H-MEM (Hierarchical Incident Memory for similar past incident recall)
METERLESS_ENGINE="H-MEM"
METERLESS_ENGINE_KEY=""

# Zetaris Network Data Layer (Dockerized local service)
# When running in local Docker: http://localhost:8080 or docker container port
ZETARIS_ENDPOINT="http://localhost:8080/v1/query"
ZETARIS_AUTH_TOKEN=""
ZETARIS_TIMEOUT_MS="5000"

# Runtime Mode: "sample" (no credentials/Docker required) or "live"
# Sherlog defaults to sample mode with synthetic data & recorded engine outputs
# if Nightshift or Zetaris endpoints are unreachable.
SHERLOG_MODE="sample"

